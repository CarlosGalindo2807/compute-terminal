{
  "name": "@compute-terminal/workers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npx --yes inngest-cli@latest dev -u http://localhost:8787/api/inngest",
    "start": "node --enable-source-maps --import tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@compute-terminal/db": "workspace:*",
    "@compute-terminal/llm": "workspace:*",
    "@compute-terminal/shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "inngest": "^3.27.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
