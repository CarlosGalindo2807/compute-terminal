# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (used by migration runner + scrapers)
SUPABASE_DB_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# --- Anthropic (Claude Sonnet 4.5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5-20251001

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability ---
AXIOM_TOKEN=
AXIOM_DATASET=compute-terminal
SENTRY_DSN=

# --- Provider discovery ---
BRAVE_SEARCH_API_KEY=

# --- Email / newsletter ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=brief@computeterminal.io

# --- Social publishing ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=

# --- Admin ---
ADMIN_EMAILS=carlos@example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Misc ---
NODE_ENV=development
